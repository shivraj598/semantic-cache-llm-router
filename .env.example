# Copy to .env and fill in. Never commit .env.
# OpenAI example:
# MODEL_SMALL=gpt-4o-mini
# MODEL_LARGE=gpt-4o
# OPENAI_API_KEY=sk-...
#
# Grok (xAI) example:
# MODEL_SMALL=grok-3-mini
# MODEL_LARGE=grok-4
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_API_KEY=xai-...
#
# Groq example (current setup: LiteLLM groq provider):
# MODEL_SMALL=groq/openai/gpt-oss-20b
# MODEL_LARGE=groq/openai/gpt-oss-120b
# GROQ_API_KEY=gsk-...
#
# Raw OpenAI-compatible form (OpenAI SDK + base_url, no LiteLLM prefix):
# MODEL_SMALL=gpt-oss-20b
# MODEL_LARGE=gpt-oss-120b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk-...  (or leave unset: falls back to GROQ_API_KEY)
#
# Ollama public / local example:
# MODEL_SMALL=ollama/llama3.1
# MODEL_LARGE=ollama/llama3.1:70b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
#
# NVIDIA NIM example:
# MODEL_SMALL=nvidia/llama-3.1-8b-instruct
# MODEL_LARGE=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_SMALL=gpt-4o-mini
MODEL_LARGE=gpt-4o
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

CORPUS_VERSION=v1
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/raglogs
# Phase-1 semantic cache (0.81 picked by eval/threshold_sweep.py: 0.72 recall, zero false hits)
# CACHE_COLLECTION=semantic_cache
# CACHE_THRESHOLD=0.81
# CACHE_TTL_SECONDS=604800
# Phase-2 router (rule-based; validated in Phase-3)
# ROUTER_SIMPLE_MAX_WORDS=15
# ROUTER_LOW_SCORE=0.40
# ROUTER_ESCALATE=true
